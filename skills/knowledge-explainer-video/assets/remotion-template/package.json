{
  "name": "knowledge-explainer-video-render",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preview": "remotion studio --no-open",
    "still": "remotion still src/index.ts KnowledgeExplainer out/representative-frame.png --frame=90",
    "render:preview": "remotion render src/index.ts KnowledgeExplainer out/preview.mp4 --codec=h264 --crf=26 --scale=0.5",
    "render": "remotion render src/index.ts KnowledgeExplainer out/final.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/captions": "4.0.526",
    "@remotion/media": "4.0.526",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
